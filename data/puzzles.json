    {
      "name": "blockstream.info",
      "priority": 2,
      "url": "https://blockstream.info/api/address/{address}",
      "balance_sats": "chain_stats.funded_txo_sum - chain_stats.spent_txo_sum",
      "auth": "none",
      "note": "Same Esplora schema as mempool.space, so it is a drop-in fallback."
    },
    {
      "name": "blockchain.info",
      "priority": 3,
      "url": "https://blockchain.info/balance?active={address}&cors=true",
      "balance_sats": "result[address].final_balance",
      "auth": "none",
      "note": "Different schema (final_balance in satoshis). Last-resort fallback."
    }
  ],
  "network_policy": {
    "balance_check_interval_seconds": 3600,
    "note": "Try balance_apis in priority order and fall through on error or timeout. The interval may only be lengthened (enforced minimum). Point the primary at your own mempool/Electrum node for zero external calls.",
    "apis_tested": "All three endpoints returned a correct balance without an API key on 2026-08-20; blockchair is kept as a human explorer link only, since its API returned empty here."
